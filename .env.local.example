# Copy this file to .env.local and fill in real values. .env.local is gitignored.

# Supabase project URL and service role key (Project Settings > API).
# The service role key is secret — it bypasses RLS. Never prefix it with
# NEXT_PUBLIC_ or use it in client-side code.
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Shared passcode Alex uses to reach /admin, plus a separate random secret
# used to sign the login session cookie. Generate the secret with:
#   openssl rand -hex 32
ADMIN_PASSCODE=
ADMIN_SESSION_SECRET=
